# Copy to .env and fill in. Compose reads this automatically.

# --- Postgres ---
POSTGRES_USER=frank
POSTGRES_PASSWORD=frank
POSTGRES_DB=frankensteincentral

# --- PowerBuy (your existing arbitrage-tracker API) ---
# Your PowerBuy login. When email/password are empty the service serves mock data.
POWERBUY_API_URL=https://powerbuy.onrender.com/api
POWERBUY_EMAIL=
POWERBUY_PASSWORD=

# --- Gmail sub-app: its own Google OAuth ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8083/auth/callback
# Fastest path: paste the Gmail refresh token your PowerBuy app already has
# (plus the client id/secret above) to go live with zero browser clicks.
GOOGLE_REFRESH_TOKEN=
# Optional: change what gets triaged. Default = primary inbox, last 7 days.
GMAIL_QUERY=

# --- Assistant auto-pilot ---
# How often the assistant syncs itself, in seconds (e.g. 900 = every 15 min).
# 0 = manual only (use the Sync/Dispatch buttons).
AUTO_SYNC_SECONDS=0

# --- Bones texts you (see docs/SETUP-NOTIFICATIONS.md) ---
# Pick ONE channel; leave blank to disable. Options: telegram | whatsapp | sms | webhook
NOTIFY_CHANNEL=
# Text a digest automatically after each sync (only when it changed): true/false
NOTIFY_ON_SYNC=false
# Your phone (for whatsapp/sms), e.g. +15551234567
NOTIFY_TO=

# Telegram (easiest): make a bot with @BotFather, then get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twilio (for whatsapp or sms)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# Or a generic webhook (Discord/Slack/etc.)
NOTIFY_WEBHOOK_URL=

# --- Vault (Vaultwarden password health — see docs/SETUP-VAULT.md) ---
# mock = sample data. bitwarden = read your real vault via the `bw serve` API.
VAULT_MODE=mock
# The Bitwarden CLI `bw serve` endpoint on your homelab, e.g. http://192.168.1.x:8087
BW_SERVE_URL=

# --- Jellyfin (media server — see docs/SETUP-JELLYFIN.md) ---
# Empty = sample data. Fill in to read your real library.
JELLYFIN_URL=
JELLYFIN_API_KEY=
# Optional; if blank, the first Jellyfin user is used.
JELLYFIN_USER_ID=
# Optional: the address your browser uses for Jellyfin (for the "Open in
# Jellyfin" deep links). Defaults to JELLYFIN_URL; set if they differ.
JELLYFIN_WEB_URL=

# --- Firefly III (self-hosted finances — see docs/SETUP-FIREFLY.md) ---
# You already run Firefly III at http://192.168.1.185:8093 — point the hub at it.
# The firefly sub-app reads it (net worth, spend, accounts, categories) and the
# Net Worth tile is sourced from it too. Both use the token below.
#
# 1) Your Firefly III base URL (what the containers read, and the "Open in
#    Firefly" link opens). Change the IP/port if yours differs.
FIREFLY_URL=http://192.168.1.185:8093
FIREFLY_WEB_URL=http://192.168.1.185:8093
# 2) In Firefly: Options -> Profile -> OAuth -> Personal Access Tokens ->
#    Create. Paste it here and restart (docker compose up -d firefly networth
#    assistant). Empty token = the hub shows sample data.
FIREFLY_TOKEN=
# Optional: the official Firefly data importer, if you run it.
FIREFLY_IMPORTER_URL=

# Only needed if you ALSO run the bundled in-stack Firefly III (service
# "fireflyiii", port 8095) instead of your own. APP_KEY must be 32 characters.
FIREFLY_APP_KEY=xQVbYZDDTTLf6B0unDPvEvVhmRW6H2jj
FIREFLY_DB_PASSWORD=firefly
FIREFLY_SITE_OWNER=admin@localhost
TZ=America/New_York
