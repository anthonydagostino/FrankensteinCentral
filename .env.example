# Copy to .env and fill in. Compose reads this automatically.

# --- Postgres ---
POSTGRES_USER=frank
POSTGRES_PASSWORD=frank
POSTGRES_DB=frankensteincentral

# --- PowerBuy (your existing arbitrage-tracker API) ---
# Your PowerBuy login. When email/password are empty the service serves mock data.
POWERBUY_API_URL=https://powerbuy.onrender.com/api
POWERBUY_EMAIL=
POWERBUY_PASSWORD=

# --- Gmail sub-app: its own Google OAuth ---
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8083/auth/callback
# Fastest path: paste the Gmail refresh token your PowerBuy app already has
# (plus the client id/secret above) to go live with zero browser clicks.
#
# CAVEAT, and it is the reason Google Calendar can look permanently broken:
# a refresh token keeps the scopes it was minted with, forever. PowerBuy's
# token was granted gmail.modify only, so Calendar answers every call with
# 403 and the week grid shows local events alone. Reusing it here connects
# Gmail and NOT Calendar. To get the calendar too, visit
# http://localhost:8083/auth/login once and approve both — that mints a new
# token carrying calendar.events, which is saved and reused from then on.
GOOGLE_REFRESH_TOKEN=
# Optional: change what gets triaged. Default = primary inbox, last 7 days.
GMAIL_QUERY=

# --- Google Calendar sync ---
# Which calendar to read and write. "primary" is the account's main one.
GOOGLE_CALENDAR_ID=primary
# How often the schedule service imports Google Calendar into its database,
# in seconds. This is independent of AUTO_SYNC_SECONDS below. 0 disables.
GCAL_SYNC_SECONDS=900

# --- Command center (core + assistant) ---
# Your local timezone — used for "today", greetings, and morning/evening mode.
LOCAL_TZ=America/New_York
# Goals, stock holdings, important senders and daily-score weights are set in
# the dashboard (⚙ Settings or ⌘K → Settings), stored by the core service.

# --- Where the deploy record lives ---
# deploy.sh writes ~/.frankenstein/deployed.json on the HOST (outside the repo,
# so `git reset --hard` during a deploy cannot erase it), and the assistant
# mounts it read-only to tell you what the box is ACTUALLY running.
#
# deploy.sh exports this itself, so a deploy driven by the poller always agrees
# with the mount. Set it here only if you keep the record somewhere else, or if
# you bring the stack up by hand with `docker compose up` as a different user
# than the one that deploys — otherwise the mount defaults to root's home and
# the dashboard reports the build as unconfirmed forever.
# FRANKENSTEIN_STATE_DIR=/home/youruser/.frankenstein

# --- Assistant auto-pilot ---
# How often the assistant syncs itself, in seconds (e.g. 900 = every 15 min).
# 0 = manual only (use the Sync/Dispatch buttons).
AUTO_SYNC_SECONDS=0

# --- Bones texts you (see docs/SETUP-NOTIFICATIONS.md) ---
# Pick ONE channel; leave blank to disable. Options: telegram | whatsapp | sms | webhook
NOTIFY_CHANNEL=
# Text a digest automatically after each sync (only when it changed): true/false
NOTIFY_ON_SYNC=false
# Your phone (for whatsapp/sms), e.g. +15551234567
NOTIFY_TO=

# Telegram (easiest): make a bot with @BotFather, then get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Twilio (for whatsapp or sms)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=

# Or a generic webhook (Discord/Slack/etc.)
NOTIFY_WEBHOOK_URL=

# --- Gateway host allowlist (SCRUM-115) ---------------------------------------
# The gateway refuses any request whose Host header names something this box
# does not answer to. That is what breaks DNS rebinding: a malicious page can
# point its own domain at your box's private address, but the browser still
# sends THAT domain in Host, and it cannot forge one it never navigated to.
#
# IP literals and localhost are always accepted, so the LAN address keeps
# working with nothing set here. Add any NAME you reach the box by — a
# Tailscale name, a hosts-file alias — comma-separated:
#
#   GATEWAY_ALLOWED_HOSTS=box.tail1234.ts.net,frank.local
GATEWAY_ALLOWED_HOSTS=

# --- Vault (Vaultwarden password health — see docs/SETUP-VAULT.md) ---
# off = not connected (empty). bitwarden = read your real vault via `bw serve`.
VAULT_MODE=off
# The Bitwarden CLI `bw serve` endpoint, e.g. http://172.17.0.1:8200 — the docker
# bridge, NOT a LAN address: unlocked, `bw serve` answers with real secrets to
# anything that can reach it. Port 8200, not the CLI's default 8087, which Tasks
# already binds on this box.
BW_SERVE_URL=
# The Vaultwarden WEB VAULT — what the 🔐 button on the dashboard header opens.
# The browser-facing UI on port 8222, not `bw serve`; works whatever VAULT_MODE is.
VAULTWARDEN_WEB_URL=http://192.168.1.185:8222

# --- Plex (a server SHARED with you — see docs/SETUP-PLEX.md) ---
# Your own Plex account token. The shared server is auto-discovered through
# plex.tv, so this works even though the server is on someone else's network.
# Empty = "not connected". The token never reaches the browser.
PLEX_TOKEN=
# Optional: pick a specific server by name if several are shared with you.
PLEX_SERVER_NAME=
# Optional: skip discovery and use a direct base URL instead.
PLEX_URL=
# Optional: where the 🎬 button on the dashboard header opens. Empty = the shared
# server via app.plex.tv, or app.plex.tv/desktop if the sub-app is not connected.
PLEX_WEB_URL=

# --- Firefly III (self-hosted finances — see docs/SETUP-FIREFLY.md) ---
# You already run Firefly III at http://192.168.1.185:8093 — point the hub at it.
# The firefly sub-app reads it (net worth, spend, accounts, categories) and the
# Net Worth tile is sourced from it too. Both use the token below.
#
# 1) Your Firefly III base URL (what the containers read, and the "Open in
#    Firefly" link opens). Change the IP/port if yours differs.
FIREFLY_URL=http://192.168.1.185:8093
FIREFLY_WEB_URL=http://192.168.1.185:8093
# 2) In Firefly: Options -> Profile -> OAuth -> Personal Access Tokens ->
#    Create. Paste it here and restart (docker compose up -d firefly networth
#    assistant). Empty token = the hub shows sample data.
FIREFLY_TOKEN=
# Optional: the official Firefly data importer, if you run one.
FIREFLY_IMPORTER_URL=

# --- internal service-to-service secret (SCRUM-114) --------------------------
# gmail's /internal/token hands out a live Google OAuth access token carrying
# gmail.modify AND calendar.events. It used to be guarded only by a docstring
# saying "internal docker network only", so /api/gmail/internal/token through
# the gateway returned that token to any unauthenticated caller on the network.
#
# The gateway now 404s any `internal` path segment, and the route itself
# requires this shared secret. Both gmail and schedule read the same value.
#
# LEAVING THIS EMPTY DISABLES THE ROUTE. It does not disable the check — an
# unset secret must not mean "no secret required", which is the original bug
# one layer down. Until you set it, the schedule service cannot borrow the
# Google credential, and the week card reports `not_configured` and says so
# rather than rendering an empty week as a clear one.
#
# You do not have to set this yourself: scripts/deploy.sh generates one into
# this file on the box when the key is missing or empty, and never rewrites a
# value that is already there. Set it by hand only to rotate it deliberately —
# and restart gmail AND schedule together when you do, or they hold different
# values until they both happen to come back.
#
# If you do want to pick one:
#   openssl rand -hex 32
FC_INTERNAL_SECRET=
