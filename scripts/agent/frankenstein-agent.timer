# TEMPLATE — NOT INSTALLED, NOT ENABLED. See frankenstein-agent.service.
[Unit]
Description=Poll the control branch for authorized Claude work

[Timer]
OnBootSec=5min
OnUnitActiveSec=5min
AccuracySec=30s

# Named explicitly rather than relying on systemd's same-name default,
# so the template says which unit it starts.
Unit=frankenstein-agent.service

[Install]
WantedBy=timers.target
