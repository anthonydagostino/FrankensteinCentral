# TEMPLATE — NOT INSTALLED, NOT ENABLED. See frankenstein-release.service.
[Unit]
Description=Poll control for Product Owner accepted work to release

[Timer]
OnBootSec=2min
OnUnitActiveSec=2min
AccuracySec=30s

# Named explicitly rather than relying on systemd's same-name default,
# so the template says which unit it starts.
Unit=frankenstein-release.service

[Install]
WantedBy=timers.target
